\encoding{UTF-8}
\name{format_environment_report}
\alias{format_environment_report}
\title{Format an environment report}
\usage{
format_environment_report(report)
}
\arguments{
\item{report}{A report returned by \code{collect_environment_report()}.}
}
\description{
Formats the environment report as Chinese Markdown for display in RStudio or a terminal.
}
\value{
A character string containing Markdown.
}

