\name{format_workbench_result}
\alias{format_workbench_result}
\title{Format an AI provider response}
\usage{
format_workbench_result(response)
}
\arguments{
\item{response}{AI provider response list.}
}
\value{
A character string for display in the workbench UI.
}
\description{
Validates and formats content, warnings, and proposed file labels from an AI provider response.
}
